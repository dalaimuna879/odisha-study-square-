const express = require('express');
const cors = require('cors');
const { createClient } = require('@supabase/supabase-js');

const app = express();
app.use(cors());
app.use(express.json());

const SUPABASE_URL = 'https://znnhtzcwnukegycnujdp.supabase.co';
const SUPABASE_KEY = 'sb_publishable_eNsVbZ5kAeh-sVjwemHGOQ_sceRkoW4';
const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

// Sab Tests lao
app.get('/api/tests', async (req, res) => {
  const { data } = await supabase.from('tests').select('*').order('created_at');
  res.json(data);
});

// Ek Test ke Questions lao
app.get('/api/questions/:testId', async (req, res) => {
  const { data } = await supabase.from('questions').select('*').eq('test_id', req.params.testId);
  res.json(data);
});

app.get('/', (req, res) => res.send('Odisha Study Square Backend Running ✅'));

const PORT = process.env.PORT || 10000;
app.listen(PORT, () => console.log('Server running on ' + PORT));
